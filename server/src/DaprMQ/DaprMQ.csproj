<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Overridable via -p:DaprActorsSdkVersion=... (e.g. to compare local nuget-local/ builds). -->
    <DaprActorsSdkVersion Condition="'$(DaprActorsSdkVersion)' == ''">1.18.4-refreshfix.1</DaprActorsSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DaprMQ.Interfaces\DaprMQ.Interfaces.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.Actors" Version="$(DaprActorsSdkVersion)" />
  </ItemGroup>

</Project>
