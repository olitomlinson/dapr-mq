<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Overridable via -p:DaprActorsSdkVersion=... (e.g. to compare local nuget-local/ builds). -->
    <DaprActorsSdkVersion Condition="'$(DaprActorsSdkVersion)' == ''">1.18.10</DaprActorsSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.Actors" Version="$(DaprActorsSdkVersion)" />
    <PackageReference Include="Dapr.Common" Version="$(DaprActorsSdkVersion)" NoWarn="NU1605" />
    <PackageReference Include="Dapr.Client" Version="$(DaprActorsSdkVersion)" NoWarn="NU1605" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

</Project>
