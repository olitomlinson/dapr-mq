# DaprMQ.Operator - control-plane service (v1: KEDA external scaler). Build from server/:
#   docker build -f Dockerfile.operator -t daprmq-operator:dev .
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/DaprMQ.Interfaces/ ./src/DaprMQ.Interfaces/
COPY src/DaprMQ.Operator/ ./src/DaprMQ.Operator/
COPY NuGet.config .
COPY nuget-local/ ./nuget-local/

WORKDIR /src/src/DaprMQ.Operator
RUN dotnet restore
RUN dotnet publish -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .

# 8080 = HTTP/1.1 health, 8081 = gRPC (KEDA scalerAddress)
EXPOSE 8080 8081

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

ENTRYPOINT ["dotnet", "DaprMQ.Operator.dll"]
