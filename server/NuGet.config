<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      local-dapr-fix: Dapr.Actors/Dapr.Actors.AspNetCore (and transitive Dapr deps) built from
      JoshVanL's proposed fix branch (actors-fix-state) in https://github.com/JoshVanL/dotnet-sdk,
      commit fb3a589 ("Actors: invalidate the default state tracker after a reentrant save"),
      instead of the official NuGet packages. See docs/DAPR_REENTRANCY_REMINDER_ISSUE.md.
    -->
    <add key="local-dapr-fix" value="./nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>