<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>DaprMQ.Client</PackageId>
    <Version>0.0.0-alpha.0</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>.NET client SDK for DaprMQ, a FIFO queue built on Dapr actors.</Description>
    <Authors>Oliver Tomlinson</Authors>
    <PackageTags>dapr;queue;fifo;messaging</PackageTags>
    <PackageProjectUrl>https://github.com/olitomlinson/dapr-mq</PackageProjectUrl>
    <RepositoryUrl>https://github.com/olitomlinson/dapr-mq</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Symbols package for debugging; Source Link (built into the SDK) maps them to the GitHub sources. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.HealthCheck" Version="2.70.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.68.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\..\server\src\DaprMQ.ApiServer\Protos\daprmq.proto" GrpcServices="Client" Link="Protos\daprmq.proto" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DaprMQ.Client.Tests" />
  </ItemGroup>

</Project>
