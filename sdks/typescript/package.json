{
  "name": "@daprmq/client",
  "version": "0.0.0-alpha.0",
  "description": "TypeScript client SDK for DaprMQ",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync-proto": "node scripts/sync-proto.mjs",
    "prebuild": "npm run sync-proto",
    "build": "tsc",
    "prepack": "npm run build",
    "pretest": "npm run sync-proto",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "npm run sync-proto",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "preperf": "npm run sync-proto",
    "perf": "vite-node perf/main.ts",
    "perf:typecheck": "tsc -p perf --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "testcontainers": "^10.28.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
